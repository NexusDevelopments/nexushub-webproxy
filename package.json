{
  "name": "nexushub",
  "version": "1.0.0",
  "description": "NexusHub - A modern web proxy powered by scramjet with React UI",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "keywords": ["proxy", "unblocker", "web", "scramjet"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "scramjet": "^4.35.0",
    "node-fetch": "^3.3.1",
    "http-proxy": "^1.18.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  }
}
